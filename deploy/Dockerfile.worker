# syntax=docker/dockerfile:1
FROM golang:1.25 AS build

WORKDIR /src
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOTOOLCHAIN=auto

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM gcr.io/distroless/base-debian13:nonroot
WORKDIR /app

COPY --from=build --chown=nonroot:nonroot /out/worker /app/worker
COPY --from=build --chown=nonroot:nonroot /src/config /app/config

ENV PORT=8080
EXPOSE 8080
USER nonroot:nonroot

ENTRYPOINT ["/app/worker"]
