# ============================================================================
# Application Configuration
# ============================================================================
APP_ENV=development
HOST=0.0.0.0
PORT=8080
CLIENT=http://localhost:3000
SERVER=http://localhost:8080/v1

# ============================================================================
# Authentication & Security
# ============================================================================
# JWT secret for token signing (use a strong random string)
JWT_SECRET=your-jwt-secret-here-change-me

# Encryption key for auth codes (must be 32-byte base64 encoded)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth redirect URL
REDIRECT_URL=http://localhost:8080/auth/callback

# Session & Token Durations
SESSION_DURATION=24h    # How long sessions last in Redis
TOKEN_DURATION=5m       # How long JWT tokens are valid
COOKIE_DURATION=24h     # How long auth cookies last

# Security Settings
DISABLE_XSRF=false      # Set to true ONLY in development (enables XSRF protection by default)

# Avatar Storage
AVATAR_STORE_PATH=/tmp/avatars  # Local filesystem path for avatar storage

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_USER=hauslet_user
DB_NAME=hauslet_db
DB_PASSWORD=your-db-password
DB_PORT=5432
DB_SSLMODE=disable

# ============================================================================
# Redis (Session Store & Caching)
# ============================================================================
REDIS_ADDR=localhost:6379

# ============================================================================
# Cloudflare R2 (Object Storage)
# ============================================================================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_ACCESS_KEY_SECRET=your-r2-secret-access-key
R2_BUCKET_NAME=hauslet-storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CDN_HOST=https://cdn.yourdomain.com

# ============================================================================
# Elasticsearch (Search & Analytics)
# ============================================================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=hauslet
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password
ELASTICSEARCH_API_KEY=

# ============================================================================
# Email Service
# ============================================================================
# Email sender address (used by both SMTP and Resend)
EMAIL_FROM=noreply@yourdomain.com

# SMTP Configuration (for development/testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Resend Configuration (for production)
RESEND_API_KEY=re_your-resend-api-key

# ============================================================================
# AI Service (Claude)
# ============================================================================
CLAUDE_API_KEY=sk-ant-your-claude-api-key
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
CLAUDE_API_MODEL=claude-3-5-sonnet-20241022

# ============================================================================
# Calendar Service Configuration
# ============================================================================
# NOTE: Calendar settings have been moved to config/defaults/calendar.yaml
# Override defaults by creating config/overrides/calendar.yaml

# ============================================================================
# Payment Gateways
# ============================================================================
# Paystack (Nigerian payments)
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

# Stripe (International payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ============================================================================
# Foreign Exchange API
# ============================================================================
FX_API_KEY=your-fx-api-key
FX_URL=https://api.currencyapi.com/

# ============================================================================
# Message Queue (RabbitMQ)
# ============================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ============================================================================
# Message Queue (NATS JetStream)
# ============================================================================
# NATS server connection URL (infrastructure only)
NATS_URL=nats://localhost:4222

# NOTE: Queue stream name, subjects, and consumers have been moved to config/defaults/queue.yaml
# Override defaults by creating config/overrides/queue.yaml