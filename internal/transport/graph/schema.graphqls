# internal/graph/schema.graphqls

scalar Time
scalar UUID
scalar Map
scalar Any

directive @goField(name: String, forceResolver: Boolean) on FIELD_DEFINITION

# The Root Mutation type
type Mutation {
  # Generic ping
  ping: String!
}

# The Root Subscription type for real-time events
type Subscription {
  # Placeholder subscription - modules extend this type
  _placeholder: String
}
