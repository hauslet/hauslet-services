# internal/property/port/graphql/schema.graphqls

# ===========================
# ENUMS
# ===========================

enum CountryCode {
  NG
  GH
}

enum CurrencyCode {
  NGN
  GHS
  USD
  EUR
}

enum OwnerType {
  landlord
  agent
  business
  individual
}

enum PropertyClass {
  residential
  commercial
}

enum PropertyType {
  apartment
  flat
  duplex
  penthouse
  studio
  house
  bungalow
  detached_house
  semi_detached
  terraced
  townhouse
  villa
  mansion
  estate
  office_space
  retail_space
  warehouse
  industrial
  mixed_use
  event_space
  co_working_space
}

enum PropertyCondition {
  new
  used
  under_renovation
  under_construction
  renovated
}

enum FurnishingType {
  furnished
  unfurnished
  semi_furnished
}

enum ListingType {
  sale
  rent
  shortlet
}

enum ListingStatus {
  active
  inactive
  pending_verification
  sold
  rented
  archived
  draft
  suspended
  under_review
  requires_updates
}

enum ReviewStatus {
  pending
  approved
  rejected
  inconclusive
}

enum PaymentPeriod {
  one_time
  daily
  weekly
  monthly
  quarterly
  bi_annually
  yearly
}

enum AccommodationType {
  single_room
  double_room
  shared_room
  entire_place
}

enum RuleCategory {
  house_rules
  general
  check_in_check_out
  cancellation_policy
  safety_and_disclosure
  custom
}

enum RuleSubCategory {
  security
  prohibited_activities
  check_in_window
  check_out_time
  check_in_method
  smoking
  pets
  events
  guests
  refund_policy
  must_know
  custom
}

enum MediaType {
  image
  video
  tour_360
  document
}

# ===========================
# CORE TYPES
# ===========================

type Location {
  lat: Float!
  lng: Float!
  srid: Int!
}

type AmenityGroup {
  group: String!
  items: [String!]!
}

type Property {
  id: UUID!
  publicId: String!
  unitNumber: String!
  address: String!
  city: String!
  state: String!
  postalCode: String!
  country: CountryCode!
  location: Location

  propertyClass: PropertyClass!
  propertyType: PropertyType!
  furnishingType: FurnishingType!
  propertyCondition: PropertyCondition!

  bedrooms: Int
  bathrooms: Int
  toilets: Int
  halfBathrooms: Int
  floors: Int
  units: Int!

  ownerId: UUID!
  squareMeters: Float!
  floorArea: Float

  amenities: [AmenityGroup!]!
  featuresCommercial: [AmenityGroup!]!

  # Relationships
  listings(first: Int, after: String): ListingConnection!

  createdAt: Time!
  updatedAt: Time!
}

type Listing {
  id: UUID!
  propertyId: UUID!
  ownerId: UUID!
  ownerType: OwnerType!
  ownerProfile: Profile

  slug: String!
  title: String!
  description: String!
  extraDescription: String
  currency: CurrencyCode!

  listingType: ListingType!
  status: ListingStatus!

  published: Boolean!
  publishedAt: Time

  latestReviewStatus: ReviewStatus!

  createdBy: UUID
  updatedBy: UUID
  statusChangedAt: Time
  changeReason: String

  hasCalendar: Boolean!

  shortletDetails: ShortletDetail
  rentalDetails: RentalDetail
  saleDetails: SaleDetail

  # Relationships
  property: Property!
  media(first: Int): [ListingMedia!]!

  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
}

type ListingMedia {
  id: UUID!
  listingId: UUID!
  url: String!
  key: String!
  type: MediaType!
  thumbnails: [ThumbnailVariant!]!
  group: String
  caption: String
  mimeType: String
  sizeBytes: Int!
  isPrimary: Boolean!
  isGroupCover: Boolean!
  order: Int!
  createdAt: Time!
  updatedAt: Time!
}

type Thumbnail {
  key: String!
  url: String!
  width: Int!
  height: Int!
  sizeBytes: Int!
  mimeType: String!
}

type ThumbnailVariant {
  size: String!
  key: String!
  url: String!
  width: Int!
  height: Int!
  sizeBytes: Int!
  mimeType: String!
}

type ShortletDetail {
  nightlyRate: Float!
  fees: [CustomFee!]!
  discounts: [Discount!]!
  bookingSettings: BookingSettings!
  stayLimits: StayLimits!
  advanceBooking: AdvanceBooking!

  maxGuests: Int!
  baseGuestCount: Int

  checkInTime: String
  checkOutTime: String

  accommodationType: AccommodationType!
  autoGenerateCalendar: Boolean!

  rules: [RuleGroup!]!
  amenitiesHighlights: [AmenityHighlight!]!
}

type CustomFee {
  name: String!
  amount: Float!
  frequency: FeeFrequency!
  category: FeeCategory!
  isRefundable: Boolean!
  isOptional: Boolean!
}

type Discount {
  name: String!
  type: DiscountType!
  percentage: Float!
  minNights: Int
  active: Boolean!
}

enum DiscountType {
  flat
  length_of_stay
}

enum FeeFrequency {
  one_time
  per_stay
  per_guest
  per_extra_guest
  per_night
  per_month
  per_year
}

enum FeeCategory {
  legal
  agency
  service
  caution
  other
}

enum ApprovalMethod {
  instant
  request
}

type BookingSettings {
  approvalMethod: ApprovalMethod!
  guestRequirements: GuestRequirements!
  preBookingMessage: String
}

type GuestRequirements {
  verifiedID: Boolean!
  positiveReviewsOnly: Boolean!
  profilePhotoRequired: Boolean!
}

type StayLimits {
  minNights: Int!
  maxNights: Int
}

type AdvanceBooking {
  monthsAhead: Int!
  minNoticeHours: Int!
}

type RentalDetail {
  rentalPrice: Float!
  rentalPricePeriod: PaymentPeriod!

  agencyFee: Float
  legalFee: Float
  registrationFee: Float
  cautionFee: Float
  serviceCharge: Float
  discounts: [Discount!]!
  fees: [CustomFee!]!
  showingAvailability: [ShowingAvailability!]
  serviceCharges: [ServiceCharge!]

  minRentalPeriod: Int!
  maxRentalPeriod: Int
  rentalAvailabilityFrom: Time

  rentalTerms: String
  rentalRules: [RuleGroup!]!
}

type SaleDetail {
  salePrice: Float!
  ownershipTitle: String!
  paymentPlan: Boolean!

  yearBuilt: Int
  yearRenovated: Int

  agencyFee: Float
  legalFee: Float
  surveyFee: Float
  titleProcessingFee: Float
  developmentFee: Float
  otherFees: Float
  serviceCharge: Float
  discounts: [Discount!]!
  fees: [CustomFee!]!
  showingAvailability: [ShowingAvailability!]
  serviceCharges: [ServiceCharge!]

  saleTerms: String
  saleAvailabilityFrom: Time
}

type AmenityHighlight {
  title: String!
  summary: String!
  icon: String!
}

type RuleItem {
  name: RuleSubCategory!
  description: Map!
}

type RuleGroup {
  category: RuleCategory!
  rules: [RuleItem!]!
}

type ServiceCharge {
  name: String!
  period: PaymentPeriod!
  amount: Float!
}

type ListingCompleteness {
  listingId: UUID!
  hasBasicInfo: Boolean!
  hasPropertyInfo: Boolean!
  hasPricingInfo: Boolean!
  hasImages: Boolean!
  hasDescription: Boolean!
  completionScore: Int!
  readyToPublish: Boolean!
  missingFields: [String!]!
  recommendations: [String!]!
  lastCalculatedAt: Time!
}

# ===========================
# CONNECTION TYPES (Relay-style)
# ===========================

type ListingEdge {
  node: Listing!
  cursor: String!
}

type ListingConnection {
  edges: [ListingEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

# ===========================
# WRAPPER TYPES (Geospatial & Search)
# ===========================

type ListingWithDistance {
  listing: Listing!
  distanceMeters: Float!
  score: Float
}

type ScoredListing {
  listing: Listing!
  score: Float
  ranking: Int!
}

# ===========================
# INPUT TYPES
# ===========================

input LocationInput {
  lat: Float!
  lng: Float!
}

input AmenityGroupInput {
  group: String!
  items: [String!]!
}

input CreateListingInput {
  ownerType: OwnerType!
  businessID: UUID  # Required if ownerType is "business"
  property: CreateListingPropertyInput!
  title: String!
  description: String!
  extraDescription: String
  currency: CurrencyCode
  listingType: ListingType!

  hasCalendar: Boolean

  shortletDetails: ShortletDetailInput
  rentalDetails: RentalDetailInput
  saleDetails: SaleDetailInput
}

input UpdateListingInput {
  property: UpdateListingPropertyInput
  title: String
  description: String
  extraDescription: String
  currency: CurrencyCode
  ownerType: OwnerType

  hasCalendar: Boolean

  shortletDetails: UpdateShortletDetailInput
  rentalDetails: UpdateRentalDetailInput
  saleDetails: UpdateSaleDetailInput
}

input ShortletDetailInput {
  nightlyRate: Float!
  cautionFee: Float
  cleaningFee: Float
  serviceFee: Float
  extraGuestFee: Float

  minNights: Int!
  maxNights: Int
  maxGuests: Int!
  baseGuestCount: Int

  checkInTime: String
  checkOutTime: String

  accommodationType: AccommodationType!
  autoAcceptBookings: Boolean

  calendarMonthsAhead: Int
  autoGenerateCalendar: Boolean

  rules: [RuleGroupInput!]
  amenitiesHighlights: [AmenityHighlightInput!]
}

input RentalDetailInput {
  rentalPrice: Float!
  rentalPricePeriod: PaymentPeriod!

  agencyFee: Float
  legalFee: Float
  registrationFee: Float
  cautionFee: Float
  serviceCharge: Float
  serviceCharges: [ServiceChargeInput!]

  minRentalPeriod: Int!
  maxRentalPeriod: Int
  rentalAvailabilityFrom: Time

  rentalTerms: String
  rentalRules: [RuleGroupInput!]
}

input SaleDetailInput {
  salePrice: Float!
  ownershipTitle: String!
  paymentPlan: Boolean

  yearBuilt: Int
  yearRenovated: Int

  agencyFee: Float
  legalFee: Float
  surveyFee: Float
  titleProcessingFee: Float
  developmentFee: Float
  otherFees: Float
  serviceCharge: Float
  serviceCharges: [ServiceChargeInput!]

  saleTerms: String
  saleAvailabilityFrom: Time
}

# Update input types - all fields optional for partial updates
input UpdateShortletDetailInput {
  nightlyRate: Float
  cautionFee: Float
  cleaningFee: Float
  serviceFee: Float
  extraGuestFee: Float

  minNights: Int
  maxNights: Int
  maxGuests: Int
  baseGuestCount: Int

  checkInTime: String
  checkOutTime: String

  accommodationType: AccommodationType
  autoAcceptBookings: Boolean

  calendarMonthsAhead: Int
  autoGenerateCalendar: Boolean

  rules: [RuleGroupInput!]
  amenitiesHighlights: [AmenityHighlightInput!]
}

input UpdateRentalDetailInput {
  rentalPrice: Float
  rentalPricePeriod: PaymentPeriod

  agencyFee: Float
  legalFee: Float
  registrationFee: Float
  cautionFee: Float
  serviceCharge: Float
  serviceCharges: [ServiceChargeInput!]

  minRentalPeriod: Int
  maxRentalPeriod: Int
  rentalAvailabilityFrom: Time

  rentalTerms: String
  rentalRules: [RuleGroupInput!]
}

input UpdateSaleDetailInput {
  salePrice: Float
  ownershipTitle: String
  paymentPlan: Boolean

  yearBuilt: Int
  yearRenovated: Int

  agencyFee: Float
  legalFee: Float
  surveyFee: Float
  titleProcessingFee: Float
  developmentFee: Float
  otherFees: Float
  serviceCharge: Float
  serviceCharges: [ServiceChargeInput!]

  saleTerms: String
  saleAvailabilityFrom: Time
}

input AmenityHighlightInput {
  title: String!
  summary: String!
  icon: String!
}

input RuleItemInput {
  name: RuleSubCategory!
  description: Map
}

input RuleGroupInput {
  category: RuleCategory!
  rules: [RuleItemInput!]!
}

input ServiceChargeInput {
  name: String!
  period: PaymentPeriod!
  amount: Float!
}

input MediaInput {
  group: String
  caption: String
  isPrimary: Boolean
  isGroupCover: Boolean
  order: Int
}

input CreateListingPropertyInput {
  unitNumber: String
  address: String!
  city: String!
  state: String!
  postalCode: String
  country: CountryCode!
  location: LocationInput

  propertyClass: PropertyClass!
  propertyType: PropertyType!
  furnishingType: FurnishingType
  propertyCondition: PropertyCondition

  bedrooms: Int
  bathrooms: Int
  toilets: Int
  halfBathrooms: Int
  floors: Int
  units: Int

  squareMeters: Float
  floorArea: Float

  amenities: [AmenityGroupInput!]
  featuresCommercial: [AmenityGroupInput!]
}

input UpdateListingPropertyInput {
  unitNumber: String
  address: String
  city: String
  state: String
  postalCode: String
  country: CountryCode
  location: LocationInput

  propertyClass: PropertyClass
  propertyType: PropertyType
  furnishingType: FurnishingType
  propertyCondition: PropertyCondition

  bedrooms: Int
  bathrooms: Int
  toilets: Int
  halfBathrooms: Int
  floors: Int
  units: Int

  squareMeters: Float
  floorArea: Float

  amenities: [AmenityGroupInput!]
  featuresCommercial: [AmenityGroupInput!]
}

# Shortlet-specific filters
input ShortletFilterInput {
  # Pricing - Extra Guest Fee
  minExtraGuestFee: Float
  maxExtraGuestFee: Float

  # Stay Duration - Range filtering for min_nights property
  minNightsMin: Int # Find listings where min_nights >= this value
  minNightsMax: Int # Find listings where min_nights <= this value

  # Stay Duration - Range filtering for max_nights property
  maxNightsMin: Int # Find listings where max_nights >= this value
  maxNightsMax: Int # Find listings where max_nights <= this value

  # Capacity
  minMaxGuests: Int # Find listings where max_guests >= this value (can accommodate at least X guests)
  baseGuestCount: Int # Find listings with exact base guest count

  # Timing - Range matching for check-in time
  checkInTimeAfter: String # HH:MM format - check-in time must be >= this (e.g., "14:00")
  checkInTimeBefore: String # HH:MM format - check-in time must be <= this (e.g., "18:00")

  # Timing - Range matching for check-out time
  checkOutTimeAfter: String # HH:MM format - check-out time must be >= this
  checkOutTimeBefore: String # HH:MM format - check-out time must be <= this

  # Type
  accommodationTypes: [AccommodationType!] # entire_place, private_room, shared_room, single_room, double_room
}

# Rental-specific filters
input RentalFilterInput {
  # Rental Terms
  rentalPricePeriods: [PaymentPeriod!] # monthly, yearly, etc. (must match one of these)

  # Rental Period - Range filtering for min_rental_period property
  minRentalPeriodMin: Int # Find listings where min_rental_period >= this
  minRentalPeriodMax: Int # Find listings where min_rental_period <= this

  # Rental Period - Range filtering for max_rental_period property
  maxRentalPeriodMin: Int # Find listings where max_rental_period >= this
  maxRentalPeriodMax: Int # Find listings where max_rental_period <= this

  # Availability Date Range
  availableFrom: Time # Property available from this date onwards
  availableTo: Time # Property available before this date
}

# Sale-specific filters
input SaleFilterInput {
  ownershipTitles: [String!] # List of acceptable title types (e.g., ["Freehold", "C of O"])
  paymentPlan: Boolean # true = must have payment plan, false = no payment plan, null = either
}

# Property filter extensions
input PropertyFilterExtension {
  propertyClasses: [PropertyClass!] # residential, commercial (must match one of these)
  propertyConditions: [PropertyCondition!] # new, used, renovated, etc. (must match one of these)
  amenities: [String!] # Must have ALL these amenities (AND logic)
}

input ListingFilterInput {
  query: String
  ownerId: UUID
  propertyId: UUID
  ownerTypes: [OwnerType!]
  listingTypes: [ListingType!]
  statuses: [ListingStatus!]
  reviewStatuses: [ReviewStatus!]
  # NOTE: published filter has been removed for security. Search always returns published listings only.
  hasCalendar: Boolean
  city: String
  state: String
  country: CountryCode
  latitude: Float
  longitude: Float
  radiusMeters: Float
  propertyTypes: [PropertyType!]
  furnishingTypes: [FurnishingType!]
  minPrice: Float
  maxPrice: Float
  currency: CurrencyCode
  minBedrooms: Int
  maxBedrooms: Int
  minBathrooms: Int
  maxBathrooms: Int

  # Type-specific filters
  shortletFilter: ShortletFilterInput
  rentalFilter: RentalFilterInput
  saleFilter: SaleFilterInput
  propertyExtension: PropertyFilterExtension
}

# ===========================
# QUERIES
# ===========================

extend type Query {
  # Listings
  listing(id: UUID!): Listing
  listingByPublicId(publicId: String!): Listing
  listingBySlug(slug: String!): Listing
  listings(filter: ListingFilterInput, first: Int, after: String): ListingConnection!
  listingsByProperty(propertyId: UUID!, first: Int, after: String): ListingConnection!
  myListings(filter: ListingFilterInput, first: Int, after: String): ListingConnection!
  listingCompleteness(listingId: UUID!): ListingCompleteness

  # Business-specific queries
  businessListings(businessId: UUID!, filter: ListingFilterInput, first: Int, after: String): ListingConnection!
  myIndividualListings(filter: ListingFilterInput, first: Int, after: String): ListingConnection!

  # Geospatial
  listingsNearPoint(lat: Float!, lng: Float!, radiusMeters: Float!, filter: ListingFilterInput, limit: Int): [ListingWithDistance!]!

  # Search
  searchListings(filter: ListingFilterInput, limit: Int): [ScoredListing!]!
  similarListings(listingId: UUID!, limit: Int, minSimilarity: Float): [ScoredListing!]!
}

# ===========================
# MUTATIONS
# ===========================

extend type Mutation {
  # Listing lifecycle
  createListing(input: CreateListingInput!): Listing!
  updateListing(id: UUID!, input: UpdateListingInput!): Listing!
  deleteListing(id: UUID!, hard: Boolean): Boolean!

  # Publishing
  publishListing(id: UUID!): Listing!
  unpublishListing(id: UUID!): Listing!
}
