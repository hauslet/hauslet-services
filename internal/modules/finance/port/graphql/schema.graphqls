# internal/modules/finance/port/graphql/schema.graphqls

enum WalletType {
  escrow
  host_available
  platform_fee
  refund_pool
}

enum WalletStatus {
  active
  frozen
  closed
}

enum FinanceTransactionType {
  charge
  refund
  payout
  commission
}

enum FinanceTransactionStatus {
  pending
  completed
  failed
}

enum DisbursementStatus {
  pending
  processing
  completed
  failed
}

type Wallet {
  id: UUID!
  ownerType: String!
  ownerId: UUID!
  walletType: WalletType!
  balance: Int!
  currency: String!
  status: WalletStatus!
  createdAt: Time!
  updatedAt: Time!
}

type LedgerEntry {
  id: UUID!
  transactionId: UUID!
  reference: String!
  debitWalletId: UUID
  creditWalletId: UUID
  amount: Int!
  currency: String!
  resourceType: String!
  resourceId: UUID!
  memo: String!
  createdAt: Time!
}

type FinanceTransaction {
  id: UUID!
  type: FinanceTransactionType!
  status: FinanceTransactionStatus!
  resourceType: String!
  resourceId: UUID!
  paymentId: UUID
  amount: Int!
  currency: String!
  metadata: Map
  ledgerEntries: [LedgerEntry!]!
  createdAt: Time!
  updatedAt: Time!
}

type Disbursement {
  id: UUID!
  walletId: UUID!
  transactionId: UUID!
  amount: Int!
  currency: String!
  status: DisbursementStatus!
  provider: String!
  transferCode: String
  attempts: Int!
  nextRetryAt: Time
  completedAt: Time
  failureReason: String
  createdAt: Time!
  updatedAt: Time!
}

type EarningsSummary {
  totalEarned: Int!
  availableBalance: Int!
  pendingPayouts: Int!
  currency: String!
}

extend type Query {
  # Admin: View wallet details
  wallet(id: UUID!): Wallet

  # Admin: List all wallets for a user
  userWallets(userId: UUID!): [Wallet!]!

  # Admin/Host: View transaction history for a resource (booking, payment, etc)
  financeTransactionHistory(
    resourceType: String!
    resourceId: UUID!
  ): [FinanceTransaction!]!

  # Admin/Host: View wallet ledger
  walletLedger(
    walletId: UUID!
    limit: Int
    offset: Int
  ): [LedgerEntry!]!

  # Admin/Host: View disbursement status
  disbursement(id: UUID!): Disbursement

  # Host: My earnings summary (requires authentication)
  myEarnings: EarningsSummary!
}

# ========================================================================
# Dispute Types
# ========================================================================

enum DisputeStatus {
  open
  investigating
  resolved_refund
  resolved_release
  cancelled
}

enum DisputeReason {
  property_mismatch
  uninhabitable
  safety_issue
  cleanliness
  amenity_missing
  no_show
  unauthorized_charges
  other
}

enum DisputeParty {
  guest
  host
}

type DisputeEvidence {
  type: String!
  url: String!
  description: String!
  uploadedBy: UUID!
  uploadedAt: Time!
}

type DisputeResolution {
  outcome: DisputeStatus!
  reason: String!
  refundAmount: Int!
  notes: String!
  resolvedAt: Time!
}

type Dispute {
  id: UUID!
  bookingId: UUID!
  walletId: UUID!
  filedBy: DisputeParty!
  filedById: UUID!
  reason: DisputeReason!
  status: DisputeStatus!
  description: String!
  amount: Int!
  currency: String!
  evidence: [DisputeEvidence!]!
  adminNotes: String
  resolution: DisputeResolution
  resolvedById: UUID
  resolvedAt: Time
  refundAmount: Int
  transactionId: UUID
  createdAt: Time!
  updatedAt: Time!
}

input FileDisputeInput {
  bookingId: UUID!
  reason: DisputeReason!
  description: String!
  amount: Int!
  currency: String!
}

input ResolveDisputeInput {
  disputeId: UUID!
  outcome: DisputeStatus!
  refundAmount: Int!
  reason: String!
  notes: String!
}

input AddDisputeEvidenceInput {
  disputeId: UUID!
  type: String!
  url: String!
  description: String!
}

extend type Query {
  # Get a specific dispute (admin or involved party)
  dispute(id: UUID!): Dispute

  # Get dispute for a booking (admin or involved party)
  disputeByBooking(bookingId: UUID!): Dispute

  # List all disputes (admin only)
  disputes(
    status: DisputeStatus
    limit: Int
    offset: Int
  ): [Dispute!]!

  # List disputes filed by current user (requires authentication)
  myDisputes(
    limit: Int
    offset: Int
  ): [Dispute!]!
}

extend type Mutation {
  # File a new dispute (guest or host)
  fileDispute(input: FileDisputeInput!): Dispute!

  # Mark dispute as investigating (admin only)
  investigateDispute(disputeId: UUID!): Dispute!

  # Resolve a dispute (admin only)
  resolveDispute(input: ResolveDisputeInput!): Dispute!

  # Cancel a dispute (disputing party only)
  cancelDispute(disputeId: UUID!): Dispute!

  # Add evidence to a dispute (involved parties only)
  addDisputeEvidence(input: AddDisputeEvidenceInput!): Dispute!
}
