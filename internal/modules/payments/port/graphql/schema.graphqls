# internal/modules/payments/port/graphql/schema.graphqls

enum PaymentStatus {
  pending
  processing
  succeeded
  failed
  refunded
  partially_refunded
}

enum PaymentMethodType {
  card
  bank_transfer
  bank_account
  mobile_money
}

enum Market {
  ghana
  kenya
  nigeria
  south_africa
  other
}

enum TransactionType {
  payment
  refund
  payout
  reversal
}

enum TransactionStatus {
  pending
  processing
  succeeded
  failed
  reversed
}

type Payment {
  id: UUID!
  reference: String!
  providerRef: String
  bookingId: UUID
  businessId: UUID
  payerId: UUID!
  payerName: String!
  payerEmail: String!
  amount: Int!
  currency: String!
  market: Market!
  status: PaymentStatus!
  description: String
  refundedAmount: Int!
  refundedAt: Time
  metadata: Map
  createdAt: Time!
  updatedAt: Time!
}

type PaymentMethod {
  id: UUID!
  userId: UUID!
  type: PaymentMethodType!
  provider: String!
  authorizationCode: String
  cardLast4: String
  cardExpMonth: Int
  cardExpYear: Int
  cardBrand: String
  bankName: String
  accountNumberLast4: String
  isDefault: Boolean!
  createdAt: Time!
  updatedAt: Time!
}

type Transaction {
  id: UUID!
  paymentId: UUID
  reference: String!
  type: TransactionType!
  amount: Int!
  currency: String!
  status: TransactionStatus!
  description: String
  providerRef: String
  providerResponse: Map
  processedAt: Time
  failureReason: String
  createdAt: Time!
}

type PayoutDetail {
  id: UUID!
  userId: UUID
  businessId: UUID
  recipientCode: String!
  bankCode: String!
  bankName: String!
  accountNumber: String!
  accountName: String!
  isActive: Boolean!
  createdAt: Time!
  updatedAt: Time!
}

input CreatePaymentMethodInput {
  authorizationCode: String!
  provider: String!
  isDefault: Boolean
}

input AddPayoutDetailInput {
  businessId: UUID
  bankCode: String!
  accountNumber: String!
  accountName: String!
  currency: String!
  market: Market!
  setAsDefault: Boolean
}

input CreatePayoutInput {
  businessId: UUID!
  amount: Int!
  currency: String!
  description: String
  recipientCode: String!
}

extend type Query {
  payment(id: UUID!): Payment
  paymentByReference(reference: String!): Payment
  myPayments(limit: Int, offset: Int, status: PaymentStatus): [Payment!]!

  paymentMethod(id: UUID!): PaymentMethod
  paymentMethods(userId: UUID!): [PaymentMethod!]!
  myPaymentMethods: [PaymentMethod!]!

  transaction(id: UUID!): Transaction
  transactionsByBooking(bookingId: UUID!): [Transaction!]!
  myTransactions(
    type: TransactionType
    status: TransactionStatus
    limit: Int
    offset: Int
  ): [Transaction!]!

  payoutDetail(id: UUID!): PayoutDetail
  myPayoutDetails: [PayoutDetail!]!
}

extend type Mutation {
  # Payment method mutations
  savePaymentMethod(input: CreatePaymentMethodInput!): PaymentMethod!
  setDefaultPaymentMethod(id: UUID!): PaymentMethod!
  deletePaymentMethod(id: UUID!): Boolean!

  # Payout mutations
  createPayoutDetail(input: AddPayoutDetailInput!): PayoutDetail!
  setDefaultPayoutDetail(id: UUID!): PayoutDetail!
  deactivatePayoutDetail(id: UUID!): PayoutDetail!
  createPayout(input: CreatePayoutInput!): Transaction!
}
