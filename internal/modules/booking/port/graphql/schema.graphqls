
enum BookingStatus {
  draft
  pending_host_approval
  awaiting_payment
  payment_failed
  confirmed
  active
  completed
  cancelled
  archived
  disputed
  settled
}

enum BookingType {
  instant
  request
}

type Booking {
  id: UUID!
  bookingReference: String!
  listingId: UUID!
  listing: Listing
  calendarEventId: UUID!
  cleaningEventId: UUID

  guestId: UUID!
  guestName: String!
  guestEmail: String!
  guestPhone: String

  guestCount: Int!

  status: BookingStatus!
  bookingType: BookingType!

  # Actual check-in/out timestamps (nullable until populated)
  checkIn: Time
  checkOut: Time

  # Scheduled check-in/out timestamps
  checkInTime: Time
  checkOutTime: Time

  holdExpiresAt: Time
  paymentDueAt: Time
  activeAt: Time
  completedAt: Time
  archivedAt: Time

  paymentReference: String
  lastPaymentId: UUID

  # Refund details
  refundAmount: Int
  refundInitiatedAt: Time
  refundProcessedAt: Time
  refundReason: String
  refundReference: String
  cancelledBy: String
  refundBreakdown: RefundBreakdownSnapshot

  specialRequests: String

  priceBreakdown: PriceBreakdownSnapshot
  totalPrice: Float!
  currency: String!

  confirmedAt: Time
  cancelledAt: Time

  createdAt: Time!
  updatedAt: Time!
  deletedAt: Time
}

type RefundBreakdownSnapshot {
  originalAmount: Float!
  currency: String!
  serviceFee: Float!
  serviceFeeRefundable: Boolean!
  baseAmountWithoutFee: Float!

  refundPercentage: Float!
  baseRefund: Float!
  processingFee: Float!
  processingFeePayer: String!
  netRefund: Float!

  nonRefundedAmount: Float!
  hostRetainedAmount: Float!
  platformRetained: Float!

  appliedPolicy: String!
  isGracePeriod: Boolean!
  hoursUntilCheckIn: Float!
  hoursAfterBooking: Float!
  cancelledBy: String!

  reason: String!
  summary: String!
  policyRules: String!

  calculatedAt: Time!
}

type PriceBreakdownSnapshot {
  baseTotal: Float!
  cleaningFee: Float
  serviceFee: Float
  cautionFee: Float
  discounts: [DiscountSnapshot!]
  nightlyRates: [DailyRate!]
  subtotal: Float!
  vatPercent: Float
  vatAmount: Float
  total: Float!
  currency: String!
  platformFees: PlatformFeeBreakdown
}

type DiscountSnapshot {
  name: String!
  amount: Float!
  type: String!
}

type DailyRate {
  date: String!
  baseRate: Float!
  finalRate: Float!
}

type PlatformFeeBreakdown {
  guestFeePercent: Float!
  guestFeeAmount: Float!
  hostCommissionPercent: Float!
  hostCommissionAmount: Float!
  payoutProcessingPercent: Float!
  payoutProcessingAmount: Float!
  minimumGuestFeeApplied: Boolean!
  hostNetAmount: Float!
}

type BookingQuote {
  listingId: UUID!
  checkIn: Time!
  checkOut: Time!
  guestCount: Int!
  available: Boolean!
  priceBreakdown: PriceBreakdownSnapshot
  totalPrice: Float!
  currency: String!

  instantBooking: Boolean!
  minNights: Int!
  maxNights: Int
  maxGuests: Int!
  checkInTime: Time
  checkOutTime: Time

  responseWindowHours: Float
  unavailabilityReason: String
}

input ReserveBookingInput {
  listingId: UUID!
  checkIn: Time!
  checkOut: Time!
  guestCount: Int!
  paymentMethodId: UUID
  specialRequests: String
}

input RequestBookingInput {
  listingId: UUID!
  checkIn: Time!
  checkOut: Time!
  guestCount: Int!
  specialRequests: String
}

input PayForBookingInput {
  bookingId: UUID!
  paymentMethodId: UUID
}

input CancelBookingInput {
  bookingId: UUID!
  reason: String
}

type CompleteBookingPayload {
  booking: Booking!
  paymentId: UUID!
  paymentStatus: String!
  paymentReference: String!
  authorizationUrl: String
  requiresAuthorization: Boolean!
}

"""
Preview of the penalty that would apply if the host cancels a booking.
"""
type CancellationPenaltyPreview {
  """Number of cancellations including this one in the rolling window."""
  cancellationCount: Int!
  """Penalty amount in minor units (e.g., kobo)."""
  penaltyAmount: Int!
  """Number of days listings would be suspended (0 if no suspension)."""
  suspensionDays: Int!
  """Whether the host is in their new-host grace period (no penalties)."""
  isNewHostGracePeriod: Boolean!
  """Whether this cancellation triggers a manual review requirement."""
  requiresReview: Boolean!
  """Human-readable warning message explaining the consequences."""
  warningMessage: String!
}

extend type Query {
  # Get pricing and availability quote without creating a booking
  quoteBooking(
    listingId: UUID!
    checkIn: Time!
    checkOut: Time!
    guestCount: Int!
  ): BookingQuote!

  # Get a single booking by ID
  booking(id: UUID!): Booking

  # Get a single booking by reference
  bookingByReference(reference: String!): Booking

  # List bookings for the authenticated guest
  myBookings(
    limit: Int
    offset: Int
  ): [Booking!]!

  # List bookings for a specific listing (owner/host view)
  listingBookings(
    listingId: UUID!
    status: BookingStatus
    limit: Int
    offset: Int
  ): [Booking!]!

  """
  Preview the penalty that would apply if the host cancels this booking.
  Only accessible to the host of the booking.
  """
  previewHostCancellationPenalty(bookingId: UUID!): CancellationPenaltyPreview!

  """
  List all bookings for listings owned by the authenticated host.
  """
  myHostBookings(
    status: BookingStatus
    limit: Int
    offset: Int
  ): [Booking!]!
}

extend type Mutation {
  # Reserve an instant booking with payment in one operation (auto-accept only)
  reserveBooking(input: ReserveBookingInput!): CompleteBookingPayload!

  # Create a manual-approval booking request (requires host approval)
  requestBooking(input: RequestBookingInput!): Booking!

  # Pay for an approved booking (after host approval or for retry)
  payForBooking(input: PayForBookingInput!): CompleteBookingPayload!

  # Confirm/approve a booking request (host action for manual-approval bookings)
  confirmBooking(bookingId: UUID!): Booking!

  # Cancel a booking
  cancelBooking(input: CancelBookingInput!): Booking!

  # Host actions to record actual stay
  checkInBooking(bookingId: UUID!): Booking!
  checkOutBooking(bookingId: UUID!): Booking!
}
