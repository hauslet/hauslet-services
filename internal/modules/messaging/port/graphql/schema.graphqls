# internal/modules/messaging/port/graphql/schema.graphqls

# ===========================
# ENUMS
# ===========================

enum ConversationType {
  inquiry
  transaction
  support
}

enum ConversationContextType {
  lead
  booking
  rental_application
  sale_negotiation
  roommate_listing
  legal_consultation
  none
}

enum ParticipantType {
  user
  host
  guest
  support_agent
  ai_agent
  system
}

enum MessageType {
  text
  image
  file
  system
}


# ===========================
# INPUT TYPES
# ===========================

input SendMessageAttachmentInput {
  id: UUID
  url: String!
  type: String
  filename: String
  metadata: Map
}

input SendMessageInput {
  conversationId: UUID!
  type: MessageType!
  content: String!
  attachments: [SendMessageAttachmentInput!]
  metadata: Map
}


# ===========================
# OBJECT TYPES
# ===========================

type Participant {
  userId: UUID!
  type: ParticipantType!
  joinedAt: Time!
  leftAt: Time
  lastReadAt: Time
  isMuted: Boolean!
  isVisible: Boolean!
}

type Message {
  id: UUID!
  conversationId: UUID!
  senderId: UUID!
  senderType: ParticipantType!
  type: MessageType!
  content: String!
  createdAt: Time!
  updatedAt: Time!
  metadata: Map
  """
  Map of user IDs to timestamps indicating when each user read this message.
  Only includes users who have read the message (not the sender).
  """
  readBy: Map
}

"""
Represents a user's typing status in a conversation.
"""
type TypingIndicator {
  conversationId: UUID!
  userId: UUID!
  isTyping: Boolean!
  timestamp: Time!
}

type Conversation {
  id: UUID!
  type: ConversationType!
  status: String!
  contextType: ConversationContextType!
  contextId: UUID!
  createdAt: Time!
  updatedAt: Time!
  lastMessageAt: Time
  participants: [Participant!]!
  unreadCounts: Map
  messages(limit: Int, offset: Int): [Message!]! @goField(forceResolver: true)
}


# ===========================
# QUERIES
# ===========================

extend type Query {
  conversation(id: UUID!): Conversation
  myConversations(limit: Int, offset: Int): [Conversation!]!
}


# ===========================
# MUTATIONS
# ===========================

extend type Mutation {
  startInquiryConversation(leadId: UUID!): Conversation!
  startTransactionConversation(contextType: ConversationContextType!, contextId: UUID!): Conversation!
  sendMessage(input: SendMessageInput!): Message!
  markConversationAsRead(conversationId: UUID!): Boolean!
  """
  Signal that the user is typing (or stopped typing) in a conversation.
  Call with isTyping=true when user starts typing, isTyping=false when they stop.
  """
  setTypingIndicator(conversationId: UUID!, isTyping: Boolean!): Boolean!
}


# ===========================
# SUBSCRIPTIONS
# ===========================

extend type Subscription {
  """
  Subscribe to new messages in a specific conversation.
  Requires user to be a participant in the conversation.
  """
  messageReceived(conversationId: UUID!): Message!

  """
  Subscribe to updates for a specific conversation (e.g., read receipts, participant changes).
  Requires user to be a participant in the conversation.
  """
  conversationUpdated(conversationId: UUID!): Conversation!

  """
  Subscribe to any updates across all of the user's conversations.
  Useful for inbox-level notifications.
  """
  myConversationsUpdated: Conversation!

  """
  Subscribe to typing indicators in a specific conversation.
  Emits when any participant starts or stops typing.
  """
  typingIndicator(conversationId: UUID!): TypingIndicator!
}
